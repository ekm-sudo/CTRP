# Connection to the Spark Thrift Server behind Hue. Ask Data Engineering for these values.
CTRP_HOST=
CTRP_PORT=10000
# LDAP (username + password), KERBEROS, NOSASL or NONE
CTRP_AUTH=LDAP
CTRP_USER=
# binary, or http if the server is reached through a gateway
CTRP_TRANSPORT=binary
CTRP_HTTP_PATH=cliservice
CTRP_SSL=false
