    {
      "title": null,
      "text": "%pyspark\n# ---------- 3. Definitions: the SQL (do not edit) and the helper functions ----------------\nimport calendar, datetime, time\n\nITEMS_SQL = \"\"\"WITH -- What: item rows in the window, cleaned (rules R1 to R13), each item numbered once.\n-- Why:  the view repeats some items many times, so duplicates must go before any count.\nraw AS (\n  -- only the 24 columns the model uses, so Spark moves far less data in every step\n  SELECT v.instance_id, v.key_itm_nbr, v.assessment_dt_wid, v.taxpayer_tin,\n         v.regime_cd, v.decl_status, v.cpc_cd, v.extended_proc_cd,\n         v.hsc_cd, v.gds_org_cty, v.customs_value, v.net_weight,\n         v.supplementary_qnty, v.tax_assessed, v.original_tax_amt, v.final_amt,\n         v.top_up_flg, v.amendment_flg, v.clearance_station_cd, v.is_red_flg,\n         v.is_yellow_flg, v.pay_status, v.consignee_tin, v.preferential_treatment_flag,\n         ROW_NUMBER() OVER (PARTITION BY v.instance_id, v.key_itm_nbr ORDER BY v.assessment_dt_wid) AS rn\n  FROM dm_modeled_ura_datascience.vw_cstm_AEO_model v\n  WHERE v.assessment_dt_wid >  '@@HIST3_START@@'\n    AND v.assessment_dt_wid <= '@@OUT_END@@'\n    AND v.regime_cd IN ('IM4', 'IM7')\n    AND v.decl_status <> 'Cancelled'\n    AND v.taxpayer_tin RLIKE '^[0-9]{10}$'\n),\n\n-- What: one row per declaration item (duplicates dropped).\nitems AS (\n  SELECT r.*, to_date(r.assessment_dt_wid, 'yyyyMMdd') AS adate\n  FROM raw r\n  WHERE r.rn = 1\n)\n\nSELECT * FROM items\n\"\"\"\nMAIN_SQL = \"\"\"WITH p AS (\n  SELECT DATE '@@SNAP_DATE@@' AS snap\n),\n\nitems AS (SELECT * FROM ctrp_items),\n\n-- What: items in the 24-month history only (features are built from history, never the future).\nhist_items AS (\n  SELECT * FROM items WHERE assessment_dt_wid > '@@HIST_START@@' AND assessment_dt_wid <= '@@SNAP@@'\n),\n\n-- ---------- one row per declaration ---------------------------------------------------\n-- What: one row per declaration with its tax, top-up and lane.\n-- Why:  tax amounts repeat on every item row, so they are taken once per declaration.\ndecl_all AS (\n  SELECT instance_id,\n         MAX(taxpayer_tin)                                   AS tin,\n         MAX(adate)                                          AS adate,\n         MAX(assessment_dt_wid)                              AS dt,\n         MAX(regime_cd)                                      AS regime,\n         COALESCE(MAX(original_tax_amt), MAX(final_amt))     AS orig_tax,\n         MAX(final_amt)                                      AS final_tax,\n         MAX(top_up_flg)                                     AS top_up_flg,\n         MAX(amendment_flg)                                  AS amended,\n         MAX(clearance_station_cd)                           AS station,\n         MAX(is_red_flg)                                     AS red,\n         MAX(is_yellow_flg)                                  AS yellow,\n         MAX(pay_status)                                     AS pay_status,\n         MAX(TRIM(consignee_tin))                            AS cons_tin,\n         SUM(customs_value)                                  AS value,\n         COUNT(*)                                            AS n_items\n  FROM items\n  GROUP BY instance_id\n),\n\ndecl AS (\n  SELECT d.*,\n         CASE WHEN d.top_up_flg = 'Y' AND d.final_tax > d.orig_tax THEN 1 ELSE 0 END             AS topped_up,\n         CASE WHEN d.top_up_flg = 'Y' AND d.final_tax > d.orig_tax\n              THEN d.final_tax - d.orig_tax ELSE 0 END                                          AS top_up,\n         CASE WHEN d.final_tax < d.orig_tax THEN 1 ELSE 0 END                                   AS negative_top_up\n  FROM decl_all d\n),\n\nhist AS (SELECT * FROM decl WHERE dt > '@@HIST_START@@' AND dt <= '@@SNAP@@'),\n\nfut  AS (SELECT * FROM decl WHERE dt >  '@@SNAP@@'),\n\n-- ---------- scored parameters and pattern features from declarations ------------------\n-- What: one row per taxpayer with every rate the scorecard uses.\ntp AS (\n  SELECT h.tin,\n         COUNT(*)                                                         AS entries_24m,\n         COUNT(DISTINCT date_format(h.adate, 'yyyyMM'))                   AS active_months,\n         AVG(h.n_items)                                                   AS avg_items_per_entry,\n         SUM(h.value)                                                     AS total_customs_value,\n         SUM(h.orig_tax)                                                  AS total_original_tax,\n         SUM(h.top_up)                                                    AS total_top_up,\n\n         AVG(CASE WHEN h.amended = 'Y' THEN 1.0 ELSE 0.0 END)             AS par045_amended_entry_rate,\n         SUM(h.top_up) / NULLIF(SUM(h.orig_tax), 0)                       AS par048_top_up_ratio,\n         AVG(CAST(h.negative_top_up AS DOUBLE))                           AS par066_negative_top_up_rate,\n         AVG(CASE WHEN h.topped_up = 1 AND h.top_up >= 0.30 * h.final_tax\n                  THEN 1.0 ELSE 0.0 END)                                  AS par077_severe_top_up_rate,\n         DATEDIFF(MAX(p.snap), MAX(CASE WHEN h.topped_up = 1 THEN h.adate END))\n                                                                          AS par105_days_since_last_top_up,\n         AVG(CAST(h.topped_up AS DOUBLE))                                 AS top_up_entry_rate,\n         DATEDIFF(MAX(p.snap), MIN(h.adate))                              AS days_since_first_in_window,\n\n         COUNT(DISTINCT h.station)                                        AS stations_used_24m,\n         COUNT(DISTINCT CASE WHEN h.adate > date_sub(p.snap, 90) THEN h.station END)\n                                                                          AS stations_used_90d,\n         SUM(CASE WHEN h.adate > date_sub(p.snap, 90) THEN 1 ELSE 0 END)  AS entries_last_90d,\n         SUM(CASE WHEN h.adate >  date_sub(p.snap, 180)\n                   AND h.adate <= date_sub(p.snap, 90) THEN 1 ELSE 0 END) AS entries_prev_90d,\n         AVG(CASE WHEN h.regime = 'IM7' THEN 1.0 ELSE 0.0 END)            AS im7_share,\n         COUNT(DISTINCT h.cons_tin)                                       AS distinct_consignees,\n         AVG(CASE WHEN h.cons_tin = h.tin THEN 1.0 ELSE 0.0 END)          AS consignee_is_self_share,\n\n         AVG(CASE WHEN h.pay_status = 'NOT_PAID' AND h.final_tax > 0\n                  THEN 1.0 ELSE 0.0 END)                                  AS ctx_unpaid_rate,\n         AVG(CASE WHEN h.red = 1 THEN 1.0 ELSE 0.0 END)                   AS ctx_red_lane_rate,\n         AVG(CASE WHEN h.yellow = 1 THEN 1.0 ELSE 0.0 END)                AS ctx_yellow_lane_rate\n  FROM hist h\n  CROSS JOIN p\n  GROUP BY h.tin\n),\n\n-- ---------- the same counts per year, over 3 years (for recency weighting) ---------------\n-- What: for each of the 3 years before the snapshot (y1 = most recent 12 months, y2 = the 12\n--       before, y3 = the 12 before that): declarations, and how many were topped up, severely\n--       topped up, amended or had tax reduced, with the top-up and original tax amounts.\n-- Why:  a recency-weighted rate is (w1 x count1 + w2 x count2 + w3 x count3) / (the same for\n--       declarations), so these counts let any weights be tried in Python without another pull.\n--       Check: y1 + y2 declarations always equal entries_24m.\nyr AS (\n  SELECT h.tin,\n         SUM(CASE WHEN h.yb = 1 THEN 1 ELSE 0 END)                         AS y1_entries,\n         SUM(CASE WHEN h.yb = 1 THEN h.topped_up ELSE 0 END)               AS y1_topped_up,\n         SUM(CASE WHEN h.yb = 1 THEN h.severe ELSE 0 END)                  AS y1_severe,\n         SUM(CASE WHEN h.yb = 1 AND h.amended = 'Y' THEN 1 ELSE 0 END)     AS y1_amended,\n         SUM(CASE WHEN h.yb = 1 THEN h.negative_top_up ELSE 0 END)         AS y1_tax_reduced,\n         SUM(CASE WHEN h.yb = 1 THEN h.top_up ELSE 0 END)                  AS y1_top_up_ugx,\n         SUM(CASE WHEN h.yb = 1 THEN h.orig_tax ELSE 0 END)                AS y1_original_tax_ugx,\n         SUM(CASE WHEN h.yb = 2 THEN 1 ELSE 0 END)                         AS y2_entries,\n         SUM(CASE WHEN h.yb = 2 THEN h.topped_up ELSE 0 END)               AS y2_topped_up,\n         SUM(CASE WHEN h.yb = 2 THEN h.severe ELSE 0 END)                  AS y2_severe,\n         SUM(CASE WHEN h.yb = 2 AND h.amended = 'Y' THEN 1 ELSE 0 END)     AS y2_amended,\n         SUM(CASE WHEN h.yb = 2 THEN h.negative_top_up ELSE 0 END)         AS y2_tax_reduced,\n         SUM(CASE WHEN h.yb = 2 THEN h.top_up ELSE 0 END)                  AS y2_top_up_ugx,\n         SUM(CASE WHEN h.yb = 2 THEN h.orig_tax ELSE 0 END)                AS y2_original_tax_ugx,\n         SUM(CASE WHEN h.yb = 3 THEN 1 ELSE 0 END)                         AS y3_entries,\n         SUM(CASE WHEN h.yb = 3 THEN h.topped_up ELSE 0 END)               AS y3_topped_up,\n         SUM(CASE WHEN h.yb = 3 THEN h.severe ELSE 0 END)                  AS y3_severe,\n         SUM(CASE WHEN h.yb = 3 AND h.amended = 'Y' THEN 1 ELSE 0 END)     AS y3_amended,\n         SUM(CASE WHEN h.yb = 3 THEN h.negative_top_up ELSE 0 END)         AS y3_tax_reduced,\n         SUM(CASE WHEN h.yb = 3 THEN h.top_up ELSE 0 END)                  AS y3_top_up_ugx,\n         SUM(CASE WHEN h.yb = 3 THEN h.orig_tax ELSE 0 END)                AS y3_original_tax_ugx,\n         DATEDIFF(MAX(h.snap), MAX(CASE WHEN h.topped_up = 1 THEN h.adate END)) AS days_since_last_top_up_36m\n  FROM (\n    SELECT d.*, p.snap,\n           CASE WHEN d.adate > add_months(p.snap, -12) THEN 1\n                WHEN d.adate > add_months(p.snap, -24) THEN 2 ELSE 3 END   AS yb,\n           CASE WHEN d.topped_up = 1 AND d.top_up >= 0.30 * d.final_tax THEN 1 ELSE 0 END AS severe\n    FROM decl d\n    CROSS JOIN p\n    WHERE d.dt <= '@@SNAP@@'\n  ) h\n  GROUP BY h.tin\n),\n\nst AS (\n  SELECT tin, MAX(n) / SUM(n) AS main_station_share\n  FROM (SELECT tin, station, COUNT(*) AS n FROM hist GROUP BY tin, station) x\n  GROUP BY tin\n),\n\n-- ---------- structure, for peer segmentation -------------------------------------------\n-- What: how each taxpayer trades (goods, origins, CPCs, stations, items per declaration).\n-- Why:  used to put taxpayers in peer groups and in the pattern check.\nstruct AS (\n  SELECT taxpayer_tin                                                     AS tin,\n         COUNT(DISTINCT substr(hsc_cd, 1, 4))                             AS hs_headings_used,\n         COUNT(DISTINCT gds_org_cty)                                      AS origins_used,\n         COUNT(DISTINCT cpc_cd)                                           AS cpcs_used,\n         AVG(CASE WHEN preferential_treatment_flag = 'Y' THEN 1.0 ELSE 0.0 END)\n                                                                          AS ctx_preferential_use_rate\n  FROM hist_items\n  GROUP BY taxpayer_tin\n),\n\n-- What: each taxpayer's main HS chapter (most customs value) and its share of their value.\ndom AS (\n  SELECT tin, hs_chapter AS dominant_hs_chapter, chapter_value_share\n  FROM (\n    SELECT taxpayer_tin AS tin,\n           substr(hsc_cd, 1, 2) AS hs_chapter,\n           SUM(customs_value) / NULLIF(SUM(SUM(customs_value)) OVER (PARTITION BY taxpayer_tin), 0)\n                                AS chapter_value_share,\n           ROW_NUMBER() OVER (PARTITION BY taxpayer_tin ORDER BY SUM(customs_value) DESC) AS rn\n    FROM hist_items\n    GROUP BY taxpayer_tin, substr(hsc_cd, 1, 2)\n  ) z\n  WHERE rn = 1\n),\n\n-- ---------- PAR_076 with the interim benchmark -----------------------------------------\n-- Benchmark = median unit value for the HS code across all importers (5 or more).\n-- Low = below half the median on BOTH bases (per kg alone where no supplementary quantity).\n-- Items below 1% of the median are treated as entry errors (a weight or quantity in the\n-- wrong unit), counted separately and kept out of the shortfall, so that one keying error\n-- cannot make a taxpayer look like the worst undervaluer in the country.\nbench AS (\n  SELECT hsc_cd,\n         percentile_approx(customs_value / net_weight, 0.5)                         AS med_per_kg,\n         percentile_approx(CASE WHEN supplementary_qnty > 0\n                                THEN customs_value / supplementary_qnty END, 0.5)    AS med_per_unit\n  FROM hist_items\n  WHERE customs_value > 0 AND net_weight > 0\n  GROUP BY hsc_cd\n  HAVING COUNT(DISTINCT taxpayer_tin) >= 5\n),\n\n-- (5) Benchmark per HS code AND origin where 5+ importers bring that code from that origin,\n-- otherwise the HS-wide benchmark above. Goods of one code differ in price by origin.\nbench_o AS (\n  SELECT hsc_cd, gds_org_cty,\n         percentile_approx(customs_value / net_weight, 0.5)                         AS med_per_kg,\n         percentile_approx(CASE WHEN supplementary_qnty > 0\n                                THEN customs_value / supplementary_qnty END, 0.5)    AS med_per_unit\n  FROM hist_items\n  WHERE customs_value > 0 AND net_weight > 0\n  GROUP BY hsc_cd, gds_org_cty\n  HAVING COUNT(DISTINCT taxpayer_tin) >= 5\n),\n\nitems_b AS (\n  SELECT i.*,\n         COALESCE(o.med_per_kg, b.med_per_kg)                             AS bm_kg,\n         CASE WHEN o.med_per_kg IS NOT NULL THEN o.med_per_unit ELSE b.med_per_unit END AS bm_unit,\n         CASE WHEN o.med_per_kg IS NOT NULL THEN 1 ELSE 0 END             AS on_origin_bench\n  FROM hist_items i\n  JOIN bench b ON i.hsc_cd = b.hsc_cd\n  LEFT JOIN bench_o o ON i.hsc_cd = o.hsc_cd AND i.gds_org_cty = o.gds_org_cty\n  WHERE i.customs_value > 0 AND i.net_weight > 0\n),\n\nval AS (\n  SELECT i.taxpayer_tin AS tin,\n         i.customs_value,\n         i.on_origin_bench,\n         -- (6) how far the price per kg sits from peers, either way (log scale)\n         ABS(LN((i.customs_value / i.net_weight) / i.bm_kg))              AS price_deviation,\n         CASE WHEN i.customs_value / i.net_weight < 0.01 * i.bm_kg THEN 1 ELSE 0 END    AS implausible,\n         CASE WHEN i.customs_value / i.net_weight <  0.5 * i.bm_kg\n               AND i.customs_value / i.net_weight >= 0.01 * i.bm_kg\n               AND (i.bm_unit IS NULL OR i.supplementary_qnty IS NULL OR i.supplementary_qnty <= 0\n                    OR i.customs_value / i.supplementary_qnty < 0.5 * i.bm_unit)\n              THEN 1 ELSE 0 END                                           AS low_price,\n         LEAST(i.bm_kg * i.net_weight - i.customs_value,\n               CASE WHEN i.supplementary_qnty > 0 AND i.bm_unit IS NOT NULL\n                    THEN i.bm_unit * i.supplementary_qnty - i.customs_value END)\n                                                                          AS shortfall\n  FROM items_b i\n),\n\nv76 AS (\n  SELECT tin,\n         COUNT(*)                                                         AS items_benchmarked,\n         AVG(CAST(implausible AS DOUBLE))                                 AS ctx_implausible_price_rate,\n         AVG(CAST(low_price AS DOUBLE))                                   AS par076_low_price_item_rate,\n         SUM(CASE WHEN low_price = 1 AND shortfall > 0 THEN shortfall ELSE 0 END)\n           / NULLIF(SUM(customs_value), 0)                                AS par076_shortfall_share,\n         AVG(CAST(on_origin_bench AS DOUBLE))                             AS origin_benchmark_share,\n         percentile_approx(CASE WHEN implausible = 0 THEN price_deviation END, 0.5)\n                                                                          AS price_deviation_median\n  FROM val\n  GROUP BY tin\n),\n\n-- ---------- (1) price against the taxpayer's own history (PAR_067 stand-in) -------------\n-- For each HS code the taxpayer imported both in the last 6 months and in the 18 months\n-- before: did the median price fall below 70% of their own earlier price, on both bases\n-- (per kg, and per unit where recorded)? Measured as a share of recent value.\nown AS (\n  SELECT i.taxpayer_tin AS tin, i.hsc_cd,\n         percentile_approx(CASE WHEN i.adate <= add_months(p.snap, -6) THEN i.customs_value / i.net_weight END, 0.5) AS early_kg,\n         percentile_approx(CASE WHEN i.adate >  add_months(p.snap, -6) THEN i.customs_value / i.net_weight END, 0.5) AS late_kg,\n         percentile_approx(CASE WHEN i.adate <= add_months(p.snap, -6) AND i.supplementary_qnty > 0\n                                THEN i.customs_value / i.supplementary_qnty END, 0.5)                          AS early_u,\n         percentile_approx(CASE WHEN i.adate >  add_months(p.snap, -6) AND i.supplementary_qnty > 0\n                                THEN i.customs_value / i.supplementary_qnty END, 0.5)                          AS late_u,\n         SUM(CASE WHEN i.adate > add_months(p.snap, -6) THEN i.customs_value ELSE 0 END)                       AS late_value,\n         SUM(CASE WHEN i.adate <= add_months(p.snap, -6) THEN 1 ELSE 0 END)                                    AS n_early,\n         SUM(CASE WHEN i.adate >  add_months(p.snap, -6) THEN 1 ELSE 0 END)                                    AS n_late\n  FROM hist_items i\n  CROSS JOIN p\n  WHERE i.customs_value > 0 AND i.net_weight > 0\n  GROUP BY i.taxpayer_tin, i.hsc_cd\n),\n\nown_tp AS (\n  SELECT tin,\n         COUNT(*)                                                         AS hs_codes_compared,\n         SUM(CASE WHEN late_kg < 0.7 * early_kg\n                   AND (early_u IS NULL OR late_u IS NULL OR late_u < 0.7 * early_u)\n                  THEN late_value ELSE 0 END) / NULLIF(SUM(late_value), 0) AS own_price_drop_share\n  FROM own\n  WHERE n_early >= 2 AND n_late >= 1 AND early_kg > 0\n  GROUP BY tin\n),\n\n-- ---------- (2) duty rate against HS peers, and exemption use -------------------------------\n-- The CPC on a declaration = EPC (extended_proc_cd, 4 digits) + APC (cpc_cd, 3 digits), per the\n-- AC-Trade memo CUS/T/9.5.5 of 19 Nov 2025. An APC other than 000 claims a rebate or\n-- exemption, so a lower rate under such an APC is expected and is NOT counted as low duty.\n-- (2a) Low duty: items under APC 000 (no exemption claimed) taxed at under half the median\n--      rate other importers pay on the same HS code, also under APC 000.\n-- (2b) Exemption use: share of value declared under any exemption APC.\n-- (2c) Watch-list APCs: share of value under the APCs the memo marks \"look out for possible\n--      abuse\" (404, 409, 417, 451, 455, 457, 476, 479, 481, 482, 484). Several of these are\n--      marked \"not in use\", so any use at all is worth an officer's attention.\nduty_bench AS (\n  SELECT hsc_cd, percentile_approx(tax_assessed / customs_value, 0.5)   AS med_rate\n  FROM hist_items\n  WHERE customs_value > 0 AND tax_assessed >= 0 AND cpc_cd = '000'\n  GROUP BY hsc_cd\n  HAVING COUNT(DISTINCT taxpayer_tin) >= 5\n),\n\nduty_tp AS (\n  SELECT i.taxpayer_tin AS tin,\n         SUM(CASE WHEN i.cpc_cd = '000' AND b.med_rate > 0 AND i.tax_assessed / i.customs_value < 0.5 * b.med_rate\n                  THEN i.customs_value ELSE 0 END)\n           / NULLIF(SUM(CASE WHEN i.cpc_cd = '000' AND b.med_rate > 0 THEN i.customs_value ELSE 0 END), 0)\n                                                                          AS low_duty_value_share,\n         SUM(CASE WHEN i.cpc_cd = '000' AND b.med_rate > 0\n                  THEN GREATEST(b.med_rate * i.customs_value - i.tax_assessed, 0) ELSE 0 END)\n           / NULLIF(SUM(CASE WHEN i.cpc_cd = '000' AND b.med_rate > 0 THEN i.customs_value ELSE 0 END), 0)\n                                                                          AS duty_gap_share\n  FROM hist_items i\n  LEFT JOIN duty_bench b ON i.hsc_cd = b.hsc_cd\n  WHERE i.customs_value > 0 AND i.tax_assessed >= 0\n  GROUP BY i.taxpayer_tin\n),\n\napc_tp AS (\n  SELECT taxpayer_tin AS tin,\n         SUM(CASE WHEN cpc_cd <> '000' THEN customs_value ELSE 0 END)\n           / NULLIF(SUM(customs_value), 0)                                AS exemption_apc_value_share,\n         SUM(CASE WHEN cpc_cd IN ('404','409','417','451','455','457','476','479','481','482','484')\n                  THEN customs_value ELSE 0 END) / NULLIF(SUM(customs_value), 0)\n                                                                          AS watchlist_apc_value_share,\n         COUNT(DISTINCT CASE WHEN cpc_cd IN ('404','409','417','451','455','457','476','479','481','482','484')\n                             THEN cpc_cd END)                             AS watchlist_apcs_used\n  FROM hist_items\n  WHERE customs_value > 0\n  GROUP BY taxpayer_tin\n),\n\n-- ---------- (3) splitting: same HS code, same day, separate declarations ------------------\n-- Bulk goods (cement, fuel, steel) legitimately arrive as many trucks a day, one declaration\n-- each. Two protections:\n--   * fixed exclusions: HS chapters 25 (cement, clinker, salt) and 27 (fuel), and fuel\n--     transit EPCs 4080 and 7180. Edit the lists below to add more.\n--   * peer norm: for every other HS code, how often ALL importers lodge same-day repeats.\n--     A taxpayer is measured by how far they exceed the norm for their own mix of goods,\n--     so a code where repeats are normal protects itself.\nsplit_grp AS (\n  SELECT taxpayer_tin AS tin, assessment_dt_wid, hsc_cd, COUNT(DISTINCT instance_id) AS n\n  FROM hist_items\n  WHERE substr(hsc_cd, 1, 2) NOT IN ('25', '27')\n    AND COALESCE(extended_proc_cd, '') NOT IN ('4080', '7180')\n  GROUP BY taxpayer_tin, assessment_dt_wid, hsc_cd\n),\n\nsplit_norm AS (\n  SELECT hsc_cd, SUM(CASE WHEN n >= 2 THEN n ELSE 0 END) / SUM(n)     AS norm_share\n  FROM split_grp\n  GROUP BY hsc_cd\n),\n\nsplit_tp AS (\n  SELECT g.tin,\n         SUM(CASE WHEN g.n >= 2 THEN g.n ELSE 0 END) / SUM(g.n)         AS same_day_split_share,\n         SUM(g.n * m.norm_share) / SUM(g.n)                              AS same_day_split_expected,\n         SUM(CASE WHEN g.n >= 2 THEN g.n ELSE 0 END) / SUM(g.n)\n           - SUM(g.n * m.norm_share) / SUM(g.n)                          AS same_day_split_excess,\n         MAX(g.n)                                                        AS max_same_day_same_hs\n  FROM split_grp g\n  JOIN split_norm m ON g.hsc_cd = m.hsc_cd\n  GROUP BY g.tin\n),\n\n-- ---------- (4) new traders: no IM4/IM7 declaration in the 3 years before the window -------\nprior AS (\n  SELECT DISTINCT taxpayer_tin AS tin\n  FROM dm_modeled_ura_datascience.vw_cstm_AEO_model\n  WHERE assessment_dt_wid >  '@@PRIOR_START@@'\n    AND assessment_dt_wid <= '@@HIST_START@@'\n    AND regime_cd IN ('IM4', 'IM7')\n    AND decl_status <> 'Cancelled'\n    AND taxpayer_tin RLIKE '^[0-9]{10}$'\n),\n\n-- ---------- outcomes in the 6 months after the snapshot --------------------------------\n-- What: what happened next: declarations checked (red or yellow) and how many ended in a top-up.\n-- Why:  the back-test judges the score against these, so they come only from AFTER the snapshot.\noutc AS (\n  SELECT tin,\n         COUNT(*)                                                         AS out_entries,\n         SUM(CASE WHEN red = 1 OR yellow = 1 THEN 1 ELSE 0 END)           AS out_checked,\n         SUM(CASE WHEN (red = 1 OR yellow = 1) AND topped_up = 1 THEN 1 ELSE 0 END)\n                                                                          AS out_checked_hits,\n         SUM(topped_up)                                                   AS out_topped_up_entries,\n         SUM(top_up)                                                      AS out_top_up,\n         SUM(orig_tax)                                                    AS out_original_tax\n  FROM fut\n  GROUP BY tin\n)\n\n-- ---------- final row per taxpayer ---\nSELECT tp.tin                                                  AS taxpayer_tin,\n       '@@SNAP_DATE@@'                                         AS snapshot_date,\n       CASE WHEN tp.entries_24m < 10 THEN 'Y' ELSE 'N' END     AS limited_history,\n       tp.entries_24m, tp.active_months, tp.avg_items_per_entry,\n       tp.total_customs_value, tp.total_original_tax, tp.total_top_up,\n       s.hs_headings_used, s.origins_used, s.cpcs_used,\n       dm.dominant_hs_chapter, dm.chapter_value_share,\n       tp.stations_used_24m, tp.stations_used_90d, st.main_station_share,\n       tp.entries_last_90d, tp.entries_prev_90d, tp.im7_share,\n       tp.distinct_consignees, tp.consignee_is_self_share,\n       tp.par045_amended_entry_rate,\n       tp.par048_top_up_ratio,\n       tp.par066_negative_top_up_rate,\n       tp.par077_severe_top_up_rate,\n       tp.par105_days_since_last_top_up,\n       tp.top_up_entry_rate,\n       v.items_benchmarked, v.par076_low_price_item_rate, v.par076_shortfall_share,\n       v.ctx_implausible_price_rate,\n       v.origin_benchmark_share, v.price_deviation_median,\n       ow.hs_codes_compared, ow.own_price_drop_share,\n       du.low_duty_value_share, du.duty_gap_share,\n       ap.exemption_apc_value_share, ap.watchlist_apc_value_share, ap.watchlist_apcs_used,\n       sp.same_day_split_share, sp.same_day_split_expected, sp.same_day_split_excess, sp.max_same_day_same_hs,\n       tp.days_since_first_in_window,\n       CASE WHEN pr.tin IS NULL THEN 'Y' ELSE 'N' END          AS new_trader,\n       tp.ctx_unpaid_rate, tp.ctx_red_lane_rate, tp.ctx_yellow_lane_rate, s.ctx_preferential_use_rate,\n       yr.y1_entries, yr.y1_topped_up, yr.y1_severe, yr.y1_amended, yr.y1_tax_reduced, yr.y1_top_up_ugx, yr.y1_original_tax_ugx,\n       yr.y2_entries, yr.y2_topped_up, yr.y2_severe, yr.y2_amended, yr.y2_tax_reduced, yr.y2_top_up_ugx, yr.y2_original_tax_ugx,\n       yr.y3_entries, yr.y3_topped_up, yr.y3_severe, yr.y3_amended, yr.y3_tax_reduced, yr.y3_top_up_ugx, yr.y3_original_tax_ugx,\n       yr.days_since_last_top_up_36m,\n       COALESCE(o.out_entries, 0)            AS out_entries,\n       COALESCE(o.out_checked, 0)            AS out_checked,\n       COALESCE(o.out_checked_hits, 0)       AS out_checked_hits,\n       COALESCE(o.out_topped_up_entries, 0)  AS out_topped_up_entries,\n       COALESCE(o.out_top_up, 0)             AS out_top_up,\n       COALESCE(o.out_original_tax, 0)       AS out_original_tax\nFROM tp\nLEFT JOIN st          ON st.tin = tp.tin\nLEFT JOIN struct s    ON s.tin  = tp.tin\nLEFT JOIN dom dm      ON dm.tin = tp.tin\nLEFT JOIN v76 v       ON v.tin  = tp.tin\nLEFT JOIN outc o      ON o.tin  = tp.tin\nLEFT JOIN own_tp ow   ON ow.tin = tp.tin\nLEFT JOIN duty_tp du  ON du.tin = tp.tin\nLEFT JOIN apc_tp ap   ON ap.tin = tp.tin\nLEFT JOIN split_tp sp ON sp.tin = tp.tin\nLEFT JOIN prior pr    ON pr.tin = tp.tin\nLEFT JOIN yr          ON yr.tin = tp.tin\n\"\"\"\nTRACKB_SQL = \"\"\"-- =====================================================================================\n-- Track B (discovery) features at @@SNAP_DATE@@, one row per taxpayer\n-- Reads the cleaned item table ctrp_items (built once per snapshot by the Zeppelin notebook,\n-- with the same cleaning rules as the main extract) and the view itself for first-seen dates.\n-- History window: items after @@HIST_START@@ up to @@SNAP@@. Recent window: the last 6 months.\n-- No input records what customs did (no top-ups, no lanes): Track B measures behaviour only.\n-- =====================================================================================\nWITH hist AS (\n  SELECT * FROM ctrp_items WHERE assessment_dt_wid > '@@HIST_START@@' AND assessment_dt_wid <= '@@SNAP@@'\n),\n\n-- What: each taxpayer's first ever IM4 or IM7 declaration up to the snapshot (whole view).\n-- Why:  \"new\" must mean new to customs, not new to the window.\nfirst_seen AS (\n  SELECT taxpayer_tin AS tin, MIN(assessment_dt_wid) AS first_dt\n  FROM dm_modeled_ura_datascience.vw_cstm_AEO_model\n  WHERE assessment_dt_wid <= '@@SNAP@@'\n    AND regime_cd IN ('IM4', 'IM7')\n    AND decl_status <> 'Cancelled'\n    AND taxpayer_tin RLIKE '^[0-9]{10}$'\n  GROUP BY taxpayer_tin\n),\n\n-- (1, 2) pace: value and declarations per active month, and the last 90 days of value\npace AS (\n  SELECT taxpayer_tin AS tin,\n         SUM(customs_value) / COUNT(DISTINCT substr(assessment_dt_wid, 1, 6))          AS value_per_active_month,\n         COUNT(DISTINCT instance_id) / COUNT(DISTINCT substr(assessment_dt_wid, 1, 6))  AS entries_per_active_month,\n         SUM(CASE WHEN adate > date_sub(DATE '@@SNAP_DATE@@', 90) THEN customs_value ELSE 0 END) AS value_last_90d,\n         SUM(customs_value)                                                             AS value_hist\n  FROM hist\n  GROUP BY taxpayer_tin\n),\n\n-- (3) duty rate per tariff line: median rate other importers pay with no exemption (APC 000)\nline_rate AS (\n  SELECT hsc_cd, substr(hsc_cd, 1, 4) AS heading,\n         percentile_approx(tax_assessed / customs_value, 0.5) AS med_rate\n  FROM hist\n  WHERE customs_value > 0 AND tax_assessed >= 0 AND cpc_cd = '000'\n  GROUP BY hsc_cd\n  HAVING COUNT(DISTINCT taxpayer_tin) >= 5\n),\n\n-- headings whose lines carry different duty: the cheapest line, and how wide the gap is\nheading_low AS (\n  SELECT heading, MIN(med_rate) AS low_rate, MAX(med_rate) AS high_rate\n  FROM line_rate\n  GROUP BY heading\n  HAVING MAX(med_rate) - MIN(med_rate) >= 0.05\n),\n\nitems_h AS (\n  SELECT i.taxpayer_tin AS tin, h.heading, i.customs_value,\n         CASE WHEN r.med_rate <= h.low_rate THEN 1 ELSE 0 END AS on_low_line\n  FROM hist i\n  JOIN line_rate r ON i.hsc_cd = r.hsc_cd\n  JOIN heading_low h ON r.heading = h.heading\n  WHERE i.customs_value > 0 AND i.cpc_cd = '000'\n),\n\n-- the share of value all importers put on the cheapest line of each heading\nheading_norm AS (\n  SELECT heading, SUM(on_low_line * customs_value) / SUM(customs_value) AS norm_low_share\n  FROM items_h\n  GROUP BY heading\n),\n\nlow_line AS (\n  SELECT i.tin,\n         SUM(i.on_low_line * i.customs_value) / SUM(i.customs_value)          AS low_line_share,\n         SUM(n.norm_low_share * i.customs_value) / SUM(i.customs_value)       AS low_line_expected,\n         SUM(i.on_low_line * i.customs_value) / SUM(i.customs_value)\n           - SUM(n.norm_low_share * i.customs_value) / SUM(i.customs_value)   AS low_line_excess,\n         SUM(i.customs_value)                                                AS low_line_value_tested\n  FROM items_h i\n  JOIN heading_norm n ON i.heading = n.heading\n  GROUP BY i.tin\n),\n\n-- (4) profile drift: recent value in chapters or origins not seen in the 18 months before\nearly_ch AS (\n  SELECT DISTINCT taxpayer_tin AS tin, substr(hsc_cd, 1, 2) AS ch\n  FROM hist WHERE adate <= add_months(DATE '@@SNAP_DATE@@', -6)\n),\nearly_or AS (\n  SELECT DISTINCT taxpayer_tin AS tin, gds_org_cty AS org\n  FROM hist WHERE adate <= add_months(DATE '@@SNAP_DATE@@', -6)\n),\nrecent AS (\n  SELECT taxpayer_tin AS tin, substr(hsc_cd, 1, 2) AS ch, gds_org_cty AS org, customs_value\n  FROM hist WHERE adate > add_months(DATE '@@SNAP_DATE@@', -6)\n),\ndrift AS (\n  SELECT r.tin,\n         SUM(CASE WHEN c.ch IS NULL THEN r.customs_value ELSE 0 END) / NULLIF(SUM(r.customs_value), 0)  AS new_chapter_value_share,\n         SUM(CASE WHEN o.org IS NULL THEN r.customs_value ELSE 0 END) / NULLIF(SUM(r.customs_value), 0) AS new_origin_value_share,\n         COUNT(*)                                                                                       AS recent_items\n  FROM recent r\n  LEFT JOIN early_ch c ON r.tin = c.tin AND r.ch = c.ch\n  LEFT JOIN early_or o ON r.tin = o.tin AND r.org = o.org\n  GROUP BY r.tin\n),\n\n-- (5) quantity: kilograms per unit against the norm for the tariff line\nkgpu_norm AS (\n  SELECT hsc_cd, percentile_approx(net_weight / supplementary_qnty, 0.5) AS med_kgpu\n  FROM hist\n  WHERE net_weight > 0 AND supplementary_qnty > 0\n  GROUP BY hsc_cd\n  HAVING COUNT(DISTINCT taxpayer_tin) >= 5\n),\nqty AS (\n  SELECT i.taxpayer_tin AS tin,\n         SUM(CASE WHEN i.net_weight / i.supplementary_qnty > 3 * n.med_kgpu\n                   AND i.net_weight / i.supplementary_qnty <= 100 * n.med_kgpu\n                  THEN i.customs_value ELSE 0 END) / NULLIF(SUM(i.customs_value), 0) AS heavy_per_unit_value_share,\n         COUNT(*)                                                                    AS items_unit_tested\n  FROM hist i\n  JOIN kgpu_norm n ON i.hsc_cd = n.hsc_cd\n  WHERE i.net_weight > 0 AND i.supplementary_qnty > 0\n  GROUP BY i.taxpayer_tin\n),\n\n-- (6) preference claimed on an origin outside the preference area (list to be confirmed by\n-- the Risk Officers: EAC and COMESA partner states, ISO two-letter codes)\npref AS (\n  SELECT taxpayer_tin AS tin,\n         SUM(CASE WHEN preferential_treatment_flag = 'Y' AND gds_org_cty NOT IN (@@PREF_ORIGINS@@)\n                  THEN customs_value ELSE 0 END)\n           / NULLIF(SUM(CASE WHEN preferential_treatment_flag = 'Y' THEN customs_value ELSE 0 END), 0)\n                                                                     AS pref_outside_area_share\n  FROM hist\n  GROUP BY taxpayer_tin\n),\n\n-- (7) exemption codes: the longest span, in months, over which one exemption APC kept being used\napc_span AS (\n  SELECT taxpayer_tin AS tin, cpc_cd,\n         months_between(to_date(MAX(assessment_dt_wid), 'yyyyMMdd'), to_date(MIN(assessment_dt_wid), 'yyyyMMdd')) AS span_months,\n         COUNT(DISTINCT substr(assessment_dt_wid, 1, 6))                                                       AS months_used\n  FROM hist\n  WHERE cpc_cd <> '000'\n  GROUP BY taxpayer_tin, cpc_cd\n),\napc_tp AS (\n  SELECT tin, MAX(span_months) AS exemption_longest_span_months, MAX(months_used) AS exemption_most_months_used\n  FROM apc_span\n  GROUP BY tin\n),\n\n-- (8) revenue at stake: the share of value in tariff lines where peers pay 25% or more\nexposure AS (\n  SELECT i.taxpayer_tin AS tin,\n         SUM(CASE WHEN r.med_rate >= 0.25 THEN i.customs_value ELSE 0 END) / NULLIF(SUM(i.customs_value), 0) AS high_duty_value_share\n  FROM hist i\n  JOIN line_rate r ON i.hsc_cd = r.hsc_cd\n  WHERE i.customs_value > 0\n  GROUP BY i.taxpayer_tin\n)\n\nSELECT p.tin                                   AS taxpayer_tin,\n       '@@SNAP_DATE@@'                         AS snapshot_date,\n       f.first_dt                              AS first_declaration_date,\n       CASE WHEN f.first_dt > '@@NEW_SINCE@@' THEN 'Y' ELSE 'N' END AS new_in_last_12m,\n       p.value_per_active_month, p.entries_per_active_month, p.value_last_90d, p.value_hist,\n       l.low_line_share, l.low_line_expected, l.low_line_excess, l.low_line_value_tested,\n       d.new_chapter_value_share, d.new_origin_value_share, d.recent_items,\n       q.heavy_per_unit_value_share, q.items_unit_tested,\n       pr.pref_outside_area_share,\n       a.exemption_longest_span_months, a.exemption_most_months_used,\n       e.high_duty_value_share\nFROM pace p\nLEFT JOIN first_seen f ON f.tin = p.tin\nLEFT JOIN low_line l   ON l.tin = p.tin\nLEFT JOIN drift d      ON d.tin = p.tin\nLEFT JOIN qty q        ON q.tin = p.tin\nLEFT JOIN pref pr      ON pr.tin = p.tin\nLEFT JOIN apc_tp a     ON a.tin = p.tin\nLEFT JOIN exposure e   ON e.tin = p.tin\n\"\"\"\n\n\ndef month_end(d, months):\n    \"\"\"The last day of the month `months` away from date d (negative = earlier).\"\"\"\n    y, m = divmod(d.year * 12 + d.month - 1 + months, 12)\n    return datetime.date(y, m + 1, calendar.monthrange(y, m + 1)[1])\n\n\ndef ymd(d):\n    return d.strftime('%Y%m%d')\n\n\ndef fill(sql, snap, live):\n    s = datetime.date.fromisoformat(snap)\n    hist_start = month_end(s, -HISTORY_MONTHS)\n    out_end = s if live else month_end(s, OUTCOME_MONTHS)\n    values = {'@@SNAP_DATE@@': snap, '@@SNAP@@': ymd(s), '@@HIST_START@@': ymd(hist_start),\n              '@@HIST3_START@@': ymd(month_end(s, -YEARS_MONTHS)), '@@OUT_END@@': ymd(out_end), '@@PRIOR_START@@': ymd(month_end(hist_start, -PRIOR_MONTHS)),\n              '@@NEW_SINCE@@': ymd(month_end(s, -12)),\n              '@@PREF_ORIGINS@@': ', '.join(\"'%s'\" % c for c in PREF_ORIGINS)}\n    for k, v in values.items():\n        sql = sql.replace(k, v)\n    return sql\n\n\ndef save(df, name):\n    \"\"\"Keep the result in memory as a table named after the extract (dashes become underscores),\n    and only write a CSV folder when SAVE_TO_FOLDER is True.\"\"\"\n    view = name.replace('-', '_')\n    df = df.cache()\n    df.createOrReplaceTempView(view)\n    n = df.count()                                  # computes it once and keeps it\n    if SAVE_TO_FOLDER:\n        df.coalesce(1).write.mode('overwrite').option('header', True).csv(OUT_DIR + '/' + name)\n    return n\n\n\ndef already_done(name):\n    \"\"\"True when this extract was finished earlier: its folder exists (when saving) or its\n    table is in this session. Lets paragraph 5 be re-run after a failure without repeating work.\"\"\"\n    if SAVE_TO_FOLDER:\n        jpath = spark._jvm.org.apache.hadoop.fs.Path(OUT_DIR + '/' + name + '/_SUCCESS')\n        return _fs.exists(jpath)\n    return name.replace('-', '_') in [t.name for t in spark.catalog.listTables()]\n\n\ndef run_snapshot(snap, live):\n    \"\"\"Build the cleaned items once, keep them in memory, write the main and Track B extracts.\"\"\"\n    name = ('live_' if live else 'bt_') + snap\n    if already_done(name):\n        print('%s: already done, skipped' % name)\n        return name\n    t0 = time.time()\n    items = spark.sql(fill(ITEMS_SQL, snap, live))\n    items.createOrReplaceTempView('ctrp_items')\n    spark.catalog.cacheTable('ctrp_items')\n    n_items = spark.table('ctrp_items').count()\n    print('%s: %s cleaned items cached (%.1f min)' % (name, format(n_items, ','), (time.time() - t0) / 60))\n    n = save(spark.sql(fill(MAIN_SQL, snap, live)), name)\n    print('%s: main extract ready, %s taxpayers (%.1f min)' % (name, format(n, ','), (time.time() - t0) / 60))\n    if RUN_TRACK_B:\n        save(spark.sql(fill(TRACKB_SQL, snap, live)), 'trackb_' + name)\n        print('%s: Track B ready (%.1f min)' % (name, (time.time() - t0) / 60))\n    spark.catalog.uncacheTable('ctrp_items')\n    return name\n\n\nprint('definitions loaded: %d snapshots to run' % len(SNAPSHOTS))",
      "user": "anonymous",
      "dateUpdated": "2026-10-13 00:00:00.000",
