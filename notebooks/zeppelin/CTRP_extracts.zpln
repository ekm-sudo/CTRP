      "status": "READY"
    },
    {
      "title": null,
      "text": "%pyspark\n# ---------- 2. Data range: does each year exist? (LIMIT 1 stops at the first row found) ----\nimport time\nt0 = time.time()\nfor year in range(2012, 2027):\n    q = \"SELECT 1 FROM %s WHERE assessment_dt_wid BETWEEN '%d0101' AND '%d1231' LIMIT 1\" % (VIEW, year, year)\n    found = len(spark.sql(q).take(1)) > 0\n    print(year, 'has data' if found else 'no data', '(%.0f s)' % (time.time() - t0))\n# Exact first and last day (reads the whole view once, no distinct counts): uncomment to run\n# spark.sql(\"SELECT MIN(assessment_dt_wid) first_day, MAX(assessment_dt_wid) last_day FROM %s \"\n#           \"WHERE regime_cd IN ('IM4','IM7')\" % VIEW).show()",
      "user": "anonymous",
      "dateUpdated": "2026-10-13 00:00:00.000",
