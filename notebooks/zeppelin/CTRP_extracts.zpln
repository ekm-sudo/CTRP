    {
      "title": null,
      "text": "%pyspark\n# ---------- 6. Check the outputs -------------------------------------------------------------\nfrom pyspark.sql import functions as F\nfor snap, live in SNAPSHOTS:\n    name = ('live_' if live else 'bt_') + snap\n    try:\n        d = spark.table(name.replace('-', '_'))\n        n, tins = d.count(), d.select('taxpayer_tin').distinct().count()\n        b = spark.table('trackb_' + name.replace('-', '_')).count() if RUN_TRACK_B else 0\n        print('%-18s %8s taxpayers  %s  Track B rows %s' % (name, format(n, ','),\n              'one row per TIN' if n == tins else 'DUPLICATE TINs', format(b, ',')))\n    except Exception as e:\n        print('%-18s not run yet (%s)' % (name, str(e).splitlines()[0][:80]))\n\n# Summary of each back-test snapshot (taxpayers, declarations, checks, hits, hit rate)\nrows = []\nfor snap, live in SNAPSHOTS:\n    name = ('live_' if live else 'bt_') + snap\n    try:\n        rows.append(spark.table(name.replace('-', '_')).select(\n            F.lit(name).alias('extract'), F.count('*').alias('taxpayers'),\n            F.sum('entries_24m').alias('declarations'), F.sum('out_checked').alias('checked'),\n            F.sum('out_checked_hits').alias('hits')))\n    except Exception:\n        pass\nif rows:\n    from functools import reduce\n    z.show(reduce(lambda a, b: a.unionByName(b), rows).withColumn('hit_rate', F.col('hits') / F.col('checked')))",
