    {
      "title": null,
      "text": "%pyspark\n# ---------- 0. Can Spark start, and where is my home folder? (writes nothing) ---------------\n_fs = spark._jvm.org.apache.hadoop.fs.FileSystem.get(spark._jsc.hadoopConfiguration())\nhome = _fs.getHomeDirectory()\nprint('Spark version   :', spark.version)\nprint('running as      :', spark.sparkContext.sparkUser())\nprint('home folder     :', home.toString())\nprint('home exists     :', _fs.exists(home))\nif _fs.exists(home):\n    st = _fs.getFileStatus(home)\n    print('home owner      :', st.getOwner(), ' permissions:', st.getPermission().toString())\nfor lib in ('pandas', 'numpy', 'sklearn', 'scipy'):\n    try:\n        print('%-15s : %s' % (lib, __import__(lib).__version__))\n    except Exception as e:\n        print('%-15s : not available' % lib)",
      "user": "anonymous",
      "dateUpdated": "2026-10-13 00:00:00.000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
          "completionSupport": true
        },
        "editorMode": "ace/mode/python",
        "colWidth": 12.0,
