    {
      "title": null,
      "text": "%pyspark\n# ---------- 1. Settings ------------------------------------------------------------------\n# Your home folder on the cluster is found automatically. Results are written to <home>/ctrp when\n# it exists; otherwise they stay in this Spark session only. Set SAVE_TO_FOLDER = False to never write.\n_fs = spark._jvm.org.apache.hadoop.fs.FileSystem.get(spark._jsc.hadoopConfiguration())\nHOME = _fs.getHomeDirectory().toString()\nOUT_DIR = HOME + '/ctrp'\nSAVE_TO_FOLDER = bool(_fs.exists(_fs.getHomeDirectory()))\nSNAPSHOTS = [('2017-09-30', False), ('2018-03-31', False), ('2018-09-30', False), ('2019-03-31', False), ('2019-09-30', False), ('2020-03-31', False), ('2020-09-30', False), ('2021-03-31', False), ('2021-09-30', False), ('2022-03-31', False), ('2022-09-30', False), ('2023-03-31', False), ('2023-09-30', False), ('2024-03-31', False), ('2024-09-30', False), ('2025-03-31', False), ('2025-09-30', False), ('2026-03-31', False), ('2026-09-30', True)]               # (date, live?) pairs\nTEST_SNAPSHOT = ('2026-03-31', False)   # paragraph 4 runs only this one\nHISTORY_MONTHS = 24               # months of history before each snapshot\nYEARS_MONTHS = 36                # the y1/y2/y3 yearly counts reach back this far\nOUTCOME_MONTHS = 6                # months of outcomes after a back-test snapshot\nPRIOR_MONTHS = 36                # look-back that decides \"new trader\" in the main extract\nPREF_ORIGINS = ['UG', 'KE', 'TZ', 'RW', 'BI', 'SS', 'CD', 'SO', 'KM', 'DJ', 'EG', 'ER', 'SZ', 'ET', 'LY', 'MG', 'MW', 'MU', 'SC', 'SD', 'TN', 'ZM', 'ZW']                 # preference partner states (to be confirmed by the officers)\nRUN_TRACK_B = True                      # also write the Track B behaviour features\nVIEW = 'dm_modeled_ura_datascience.vw_cstm_AEO_model'\nprint('settings loaded;', ('output goes to ' + OUT_DIR) if SAVE_TO_FOLDER else 'results kept in memory only, nothing is written')",
      "user": "anonymous",
      "dateUpdated": "2026-10-13 00:00:00.000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
