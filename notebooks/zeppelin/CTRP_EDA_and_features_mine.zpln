    },
    {
      "title": "6.1 topped_up_per_decl_24m_rate",
      "text": "%pyspark\n# PAR_045T: declarations topped up / declarations\ntop_up_rate = hist.groupBy('taxpayer_tin').agg(F.avg('topped_up').alias('topped_up_per_decl_24m_rate'))\ntop_up_rate.show(5)",
