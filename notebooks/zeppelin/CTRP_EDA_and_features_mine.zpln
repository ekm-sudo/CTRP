      "status": "READY"
    },
    {
      "title": "7.9 hs4_per_decl_24m_ratio",
      "text": "%pyspark\nheadings = hist_items.groupBy('taxpayer_tin').agg(F.countDistinct(F.substring('hsc_cd', 1, 4)).alias('hs4_24m_count'))\ngoods = base.select('taxpayer_tin', 'decl_24m_count').join(headings, 'taxpayer_tin', 'left')\ngoods = goods.withColumn('hs4_per_decl_24m_ratio', F.col('hs4_24m_count') / F.greatest('decl_24m_count', F.lit(1)))\ngoods = goods.drop('decl_24m_count')\ngoods.show(5)",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
