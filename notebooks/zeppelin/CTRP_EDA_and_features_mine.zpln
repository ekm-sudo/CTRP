    },
    {
      "title": "7.2 pref_claimed_per_item_24m_rate",
      "text": "%pyspark\n# items claiming preferential treatment / items\nclaims = F.when(F.col('preferential_treatment_flag') == 'Y', 1.0).otherwise(0.0)\npreference_rate = hist_items.groupBy('taxpayer_tin').agg(F.avg(claims).alias('pref_claimed_per_item_24m_rate'))\npreference_rate.show(5)",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "python",
