      "status": "READY"
    },
    {
      "title": "7.8 decl_90d_per_avg_qtr_24m_log",
      "text": "%pyspark\n# declarations in the last 90 days against an average quarter (24 months / 8), log scale\nin_last_90_days = F.when(F.col('adate') > F.date_sub(snap_date, 90), 1).otherwise(0)\nsurge = hist.groupBy('taxpayer_tin').agg(F.count('*').alias('n'), F.sum(in_last_90_days).alias('decl_90d_count'))\nsurge = surge.withColumn('decl_90d_per_avg_qtr_24m_log', F.log((F.col('decl_90d_count') + 1) / (F.col('n') / 8.0 + 1))).drop('n')\nsurge.orderBy(F.desc('decl_90d_per_avg_qtr_24m_log')).show(5)",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
      "progress": 0,
