      "status": "READY"
    },
    {
      "title": "5. Declarations",
      "text": "%md\n## 5. Declarations\n\nTax, top-up, lane and status repeat on every item of a declaration, so I group items into one row per declaration.\n* original tax blank = unchanged, so it takes the final tax (E08)\n* topped up = flag Y **and** final tax above original tax (E06); top-up amount = final minus original (E09)\n* tax reduced = final tax below original tax\n* severe = top-up of 30% or more of the final tax",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "markdown",
          "editOnDblClick": true,
          "completionSupport": false
        },
        "editorMode": "ace/mode/markdown",
        "colWidth": 12.0,
        "fontSize": 9.0,
        "title": false,
        "editorHide": true,
        "results": {},
        "enabled": true
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_ctrp_mine_046",
      "id": "paragraph_ctrp_mine_046",
      "dateCreated": "2026-10-20 00:00:00.000",
      "status": "READY"
    },
    {
      "title": "5. Declarations",
      "text": "%pyspark\ndecl = items.groupBy('instance_id').agg(\n    F.max('taxpayer_tin').alias('taxpayer_tin'),\n    F.max('taxpayer_nm').alias('taxpayer_nm'),\n    F.max('adate').alias('adate'),\n    F.max('assessment_dt_wid').alias('dt'),\n    F.max('regime_cd').alias('regime'),\n    F.coalesce(F.max('original_tax_amt'), F.max('final_amt')).alias('orig_tax'),\n    F.max('final_amt').alias('final_tax'),\n    F.max('top_up_flg').alias('top_up_flg'),\n    F.max('amendment_flg').alias('amended'),\n    F.max('clearance_station_cd').alias('station'),\n    F.max('is_red_flg').alias('red'),\n    F.max('is_yellow_flg').alias('yellow'),\n    F.max('pay_status').alias('pay_status'),\n    F.sum('customs_value').alias('value'),\n    F.count('*').alias('n_items'),\n)\n\nis_top_up = (F.col('top_up_flg') == 'Y') & (F.col('final_tax') > F.col('orig_tax'))\ndecl = decl.withColumn('topped_up', F.when(is_top_up, 1).otherwise(0))\ndecl = decl.withColumn('top_up', F.when(is_top_up, F.col('final_tax') - F.col('orig_tax')).otherwise(0.0))\ndecl = decl.withColumn('negative_top_up', F.when(F.col('final_tax') < F.col('orig_tax'), 1).otherwise(0))\nis_severe = (F.col('topped_up') == 1) & (F.col('top_up') >= 0.30 * F.col('final_tax'))\ndecl = decl.withColumn('severe', F.when(is_severe, 1).otherwise(0))\ndecl = decl.cache()\n\n# the 24 months the features use\nhist = decl.filter((F.col('dt') > HIST_START) & (F.col('dt') <= SNAP)).cache()\nhist_items = items.filter((F.col('assessment_dt_wid') > HIST_START) & (F.col('assessment_dt_wid') <= SNAP)).cache()\nprint('declarations in the 24 months:', hist.count())\nhist.show(5)",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "python",
