    },
    {
      "title": "6.5 tax_reduced_per_decl_24m_rate",
      "text": "%pyspark\n# PAR_066: declarations whose tax was reduced / declarations\nreduced_rate = hist.groupBy('taxpayer_tin').agg(F.avg('negative_top_up').alias('tax_reduced_per_decl_24m_rate'))\nreduced_rate.show(5)",
