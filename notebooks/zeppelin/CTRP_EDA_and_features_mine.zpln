    {
      "title": "2.3 Duplicates",
      "text": "%md\n## 2.3 Duplicates\n\nFour kinds: the same row copied, the same item repeated, the same entry under two or more declaration IDs, and one\ndeclaration ID with more than one taxpayer or date.",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "markdown",
          "editOnDblClick": true,
          "completionSupport": false
        },
        "editorMode": "ace/mode/markdown",
        "colWidth": 12.0,
        "fontSize": 9.0,
        "title": false,
        "editorHide": true,
        "results": {},
        "enabled": true
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_ctrp_mine_012",
      "id": "paragraph_ctrp_mine_012",
      "dateCreated": "2026-10-20 00:00:00.000",
      "status": "READY"
    },
    {
      "title": "2.3 Duplicates",
      "text": "%pyspark\nn_rows = eda.count()\nn_different_rows = eda.distinct().count()\nn_items = eda.select('instance_id', 'key_itm_nbr').distinct().count()\nprint('rows:', n_rows)\nprint('rows that are an exact copy of another row:', n_rows - n_different_rows)\nprint('rows that repeat an item (same declaration ID + item number):', n_rows - n_items)\n\n# are the copies of each item identical? count the different versions of each item\nversions = eda.distinct().groupBy('instance_id', 'key_itm_nbr').count()\nprint('items whose copies are NOT identical:', versions.filter(F.col('count') > 1).count())\n\ncopies = eda.groupBy('instance_id', 'key_itm_nbr').count()\nprint('most copies of one item:', copies.agg(F.max('count')).first()[0])\n\nids_per_entry = eda.groupBy('entry_key').agg(F.countDistinct('instance_id').alias('ids'))\nprint('entries under more than one declaration ID:', ids_per_entry.filter(F.col('ids') > 1).count())\n\nper_id = eda.groupBy('instance_id').agg(F.countDistinct('taxpayer_tin').alias('tins'),\n                                        F.countDistinct('assessment_dt_wid').alias('dates'))\nprint('declaration IDs with more than one TIN (expected 0):', per_id.filter(F.col('tins') > 1).count())\nprint('declaration IDs with more than one date (expected 0):', per_id.filter(F.col('dates') > 1).count())\n\nprint('The items with the most copies:')\ncopies.orderBy(F.desc('count')).show(5)",
