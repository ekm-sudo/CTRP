      "jobName": "paragraph_ctrp_mine_063",
      "id": "paragraph_ctrp_mine_063",
      "dateCreated": "2026-10-20 00:00:00.000",
      "status": "READY"
    },
    {
      "title": "7.6 APC features",
      "text": "%pyspark\nWATCHLIST = ['404', '409', '417', '451', '455', '457', '476', '479', '481', '482', '484']\nvalued = hist_items.filter(F.col('customs_value') > 0)\nexempt_value = F.sum(F.when(F.col('cpc_cd') != '000', F.col('customs_value')).otherwise(0))\nwatchlist_value = F.sum(F.when(F.col('cpc_cd').isin(WATCHLIST), F.col('customs_value')).otherwise(0))\napc = valued.groupBy('taxpayer_tin').agg(\n    (exempt_value / F.sum('customs_value')).alias('exempt_apc_per_value_24m_rate'),\n    (watchlist_value / F.sum('customs_value')).alias('watchlist_apc_per_value_24m_rate'))\napc.show(5)",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
      "progress": 0,
      "config": {
