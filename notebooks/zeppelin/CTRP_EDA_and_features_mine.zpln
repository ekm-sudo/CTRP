    {
      "title": "2.2 Missing data",
      "text": "%md\n## 2.2 Missing data\n\nFor each column: how many rows are blank, and (for numbers) how many are zero or less. Then the same per year,\nto see if it is getting better or worse, and a test of what a blank original tax means.",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "markdown",
          "editOnDblClick": true,
          "completionSupport": false
        },
        "editorMode": "ace/mode/markdown",
        "colWidth": 12.0,
        "fontSize": 9.0,
        "title": false,
        "editorHide": true,
        "results": {},
        "enabled": true
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_ctrp_mine_007",
      "id": "paragraph_ctrp_mine_007",
      "dateCreated": "2026-10-20 00:00:00.000",
      "status": "READY"
    },
    {
      "title": "2.2 Missing data",
      "text": "%pyspark\nBLANK_MEANS = {'taxpayer_tin': 'No taxpayer: the row is dropped (R1, E03)',\n               'entry_num': 'No entry number: the declaration ID is used as the entry key',\n               'clearance_station_cd': 'No station: counted as a station of its own in the station measures',\n               'dec_ref_yer': 'No year: the declaration ID is used as the entry key',\n               'decl_status': 'No status: the row is dropped with the cancelled ones (R3)',\n               'regime_cd': 'No regime: the row is dropped (R4)',\n               'hsc_cd': 'No tariff code: no price or duty benchmark for the item; it still counts in its declaration',\n               'gds_org_cty': 'No origin: the item is compared with the benchmark for its HS code across all origins',\n               'cpc_cd': 'No APC: not counted as exempt, and left out of the duty comparison (that uses APC 000 only)',\n               'customs_value': 'No value: left out of the price, duty and APC features (E11)',\n               'net_weight': 'No weight: left out of the price features (E11)',\n               'supplementary_qnty': 'No units: the price is compared per kg only',\n               'tax_assessed': 'No item tax: left out of the duty features',\n               'original_tax_amt': 'Read as unchanged: the final tax is used (E08)',\n               'final_amt': 'No final tax: no top-up or tax reduction can be counted',\n               'top_up_amt': 'Not used by the model (E09)',\n               'top_up_flg': 'Read as no top-up',\n               'amendment_flg': 'Read as not amended',\n               'pay_status': 'Read as not unpaid',\n               'preferential_treatment_flag': 'Read as no preference claimed',\n               'is_red_flg': 'Read as not red (used only for outcomes)',\n               'is_yellow_flg': 'Read as not yellow (used only for outcomes)',\n               'assessment_dt_wid': 'No date: outside every window, so not used'}\n\ntext_columns = ['taxpayer_tin', 'entry_num', 'clearance_station_cd', 'dec_ref_yer', 'decl_status', 'regime_cd',\n                'hsc_cd', 'gds_org_cty', 'cpc_cd', 'top_up_flg', 'amendment_flg', 'pay_status',\n                'preferential_treatment_flag', 'assessment_dt_wid']\nnumber_columns = ['customs_value', 'net_weight', 'supplementary_qnty', 'tax_assessed', 'original_tax_amt',\n                  'final_amt', 'top_up_amt', 'is_red_flg', 'is_yellow_flg']\n\nn = eda.count()\nresults = []\nfor c in text_columns + number_columns:\n    blank = eda.filter(F.col(c).isNull()).count()\n    results.append([c, blank, round(100.0 * blank / n, 2), BLANK_MEANS.get(c, '')])\nmissing = pd.DataFrame(results, columns=['column', 'blank rows', 'blank %', 'what the model does'])\nprint(missing.sort_values('blank %', ascending=False).to_string(index=False))",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
          "completionSupport": true
        },
