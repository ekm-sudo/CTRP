      "status": "READY"
    },
    {
      "title": "7.3 price features",
      "text": "%pyspark\n# from the item table of 6.8\nprice_features = it.groupBy('taxpayer_tin').agg(\n    F.avg('implausible').alias('price_keying_error_per_item_24m_rate'),          # under 1% of the benchmark\n    F.avg('low_price').alias('price_under_half_peer_per_item_24m_rate'),            # under half the benchmark\n    F.expr('percentile_approx(CASE WHEN implausible = 0 THEN price_deviation END, 0.5)').alias('median_price_dev_from_peer_24m_log'),\n    F.avg('on_origin_bench').alias('priced_on_coo_peer_per_item_24m_rate'))\nprice_features.show(5)",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
          "completionSupport": true
        },
        "editorMode": "ace/mode/python",
        "colWidth": 12.0,
        "fontSize": 9.0,
        "title": true,
