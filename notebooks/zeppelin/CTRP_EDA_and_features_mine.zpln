    },
    {
      "title": "7.1 unpaid_tax_per_decl_24m_rate",
      "text": "%pyspark\n# tax due and NOT_PAID / declarations\nunpaid = F.when((F.col('pay_status') == 'NOT_PAID') & (F.col('final_tax') > 0), 1.0).otherwise(0.0)\nunpaid_rate = hist.groupBy('taxpayer_tin').agg(F.avg(unpaid).alias('unpaid_tax_per_decl_24m_rate'))\nunpaid_rate.show(5)",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
