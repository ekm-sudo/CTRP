    },
    {
      "title": "5.2 severe_top_up_per_decl_24m_rate",
      "text": "%pyspark\nparts['severe_top_up_per_decl_24m_rate'] = (hist.groupBy('taxpayer_tin')\n                                         .agg(F.avg('severe').alias('severe_top_up_per_decl_24m_rate')))\npeek(parts['severe_top_up_per_decl_24m_rate'])",
      "user": "anonymous",
