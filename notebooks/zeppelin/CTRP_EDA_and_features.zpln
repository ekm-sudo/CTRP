    },
    {
      "title": "6.2 pref_claimed_per_item_24m_rate",
      "text": "%pyspark\nclaims = F.when(F.col('preferential_treatment_flag') == 'Y', 1.0).otherwise(0.0)\nparts['pref_claimed_per_item_24m_rate'] = (hist_items.groupBy('taxpayer_tin')\n                                                 .agg(F.avg(claims).alias('pref_claimed_per_item_24m_rate')))\npeek(parts['pref_claimed_per_item_24m_rate'])",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
