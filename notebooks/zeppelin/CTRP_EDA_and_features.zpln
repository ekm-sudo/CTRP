        "forms": {}
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_ctrp_eda_034",
      "id": "paragraph_ctrp_eda_034",
      "dateCreated": "2026-10-20 00:00:00.000",
      "status": "READY"
    },
    {
      "title": "5.1 topped_up_per_decl_24m_rate",
      "text": "%pyspark\nparts['topped_up_per_decl_24m_rate'] = hist.groupBy('taxpayer_tin').agg(F.avg('topped_up').alias('topped_up_per_decl_24m_rate'))\npeek(base.join(parts['topped_up_per_decl_24m_rate'], 'taxpayer_tin').select('taxpayer_tin', 'decl_24m_count', 'topped_up_per_decl_24m_rate'))",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
