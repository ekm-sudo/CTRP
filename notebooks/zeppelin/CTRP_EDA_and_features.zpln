      "jobName": "paragraph_ctrp_eda_073",
      "id": "paragraph_ctrp_eda_073",
      "dateCreated": "2026-10-20 00:00:00.000",
      "status": "READY"
    },
    {
      "title": "7.2 One table",
      "text": "%pyspark\n# Every part side by side: one row per taxpayer (small enough to work on in pandas from here)\nfeature_inputs = reduce(lambda table, part: table.join(part, 'taxpayer_tin', 'left'), parts.values(), base)\nsave(feature_inputs, 'ctrp_feature_inputs')\ntp = feature_inputs.orderBy('taxpayer_tin').toPandas()\nprint('{:,} taxpayers x {} columns'.format(*tp.shape))\npeek(tp)",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
          "completionSupport": true
        },
        "editorMode": "ace/mode/python",
        "colWidth": 12.0,
        "fontSize": 9.0,
        "title": true,
        "editorHide": false,
        "results": {},
