    },
    {
      "title": "2.3 Copies per item",
      "text": "%pyspark\n# How many copies items have\ncopy_band = (F.when(F.col('count') == 1, '1 (no copy)').when(F.col('count') == 2, '2')\n              .when(F.col('count') <= 10, '3 to 10').when(F.col('count') <= 100, '11 to 100').otherwise('over 100'))\nz.show(copies.groupBy(copy_band.alias('copies of the item')).agg(F.count('*').alias('items')).orderBy('copies of the item'))",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "python",
