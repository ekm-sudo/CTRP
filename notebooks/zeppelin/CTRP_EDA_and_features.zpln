      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_ctrp_eda_010",
      "id": "paragraph_ctrp_eda_010",
      "dateCreated": "2026-10-20 00:00:00.000",
      "status": "READY"
    },
    {
      "title": "2.2 Original tax blank",
      "text": "%pyspark\n# Test of \"blank original tax means unchanged\" (E08): if it is true, declarations WITH a top-up should almost\n# never have a blank original tax, because a top-up changes the tax\nper_declaration = eda.groupBy('instance_id').agg(F.max('top_up_flg').alias('flag'),\n                                                 F.max('original_tax_amt').alias('original_tax'))\nz.show(per_declaration\n       .groupBy(F.coalesce(F.col('flag'), F.lit('blank')).alias('top-up flag'))\n       .agg(F.count('*').alias('declarations'),\n            F.round(100 * F.avg(F.col('original_tax').isNull().cast('double')), 1).alias('original tax blank %')))",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
          "completionSupport": true
        },
        "editorMode": "ace/mode/python",
        "colWidth": 12.0,
        "fontSize": 9.0,
        "title": true,
        "editorHide": false,
        "results": {},
        "enabled": true
      },
      "settings": {
