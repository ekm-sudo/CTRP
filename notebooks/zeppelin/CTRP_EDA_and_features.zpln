      "status": "READY"
    },
    {
      "title": "Settings",
      "text": "%pyspark\n# ===================== Settings: the only paragraph to edit =====================\nSNAPSHOT = '2026-09-30'          # the day the risk profile is made (the last day of a month)\nWITH_OUTCOMES = False              # True for a past snapshot: adds what happened in the 6 months after it\nSAMPLE_1_IN = None                 # e.g. 20 = a quick trial on 1 in 20 taxpayers. None = every taxpayer\n\n# The agreed cleaning rules that can be switched (all on)\nEXCLUDE_APC_483 = True              # R13 APC 483: destroyed or abandoned goods, dummy entries\nLATEST_DECLARATION_PER_ENTRY = True    # R14 one declaration per entry (entry number + station + year)\nEXCLUDE_MOTOR_VEHICLES = True          # R15 motor vehicles have their own model\nMOTOR_VEHICLE_HEADINGS = ['8701', '8702', '8703', '8704', '8705', '8706', '8707', '8708', '8711']\n\n# Where results go. Every result is always kept as a table in this session.\nSAVE_TO_FOLDER = False             # True: also write CSV files under OUT_DIR (needs a folder you can write to)\nOUT_DIR = '/user/CHANGE_ME/ctrp_eda'\nSAVE_TO_SCHEMA = None              # e.g. 'my_sandbox': also save as Hive tables (download from Hue as Excel)\nPRODUCTION_TABLE = None            # optional, for Part 8.2: a table holding the production extract for SNAPSHOT\n\nVIEW = 'dm_modeled_ura_datascience.vw_cstm_AEO_model'",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
          "completionSupport": true
        },
        "editorMode": "ace/mode/python",
        "colWidth": 12.0,
        "fontSize": 9.0,
        "title": true,
        "editorHide": false,
        "results": {},
