    },
    {
      "title": "8.3 Check",
      "text": "%pyspark\nname = PRODUCTION_TABLE or ('%s_%s' % ('bt' if WITH_OUTCOMES else 'live', SNAPSHOT.replace('-', '_')))\ntry:\n    prod = spark.table(name)\nexcept Exception:\n    prod = None\n    print('No production extract named %s in this session: check skipped.' % name)\n\nif prod is not None:\n    PRODUCTION_COLUMN = {'decl_24m_count': 'entries_24m',\n                         'customs_value_24m_ugx': 'total_customs_value',\n                         'original_tax_24m_ugx': 'total_original_tax',\n                         'top_up_24m_ugx': 'total_top_up',\n                         'topped_up_per_decl_24m_rate': 'top_up_entry_rate',\n                         'severe_top_up_per_decl_24m_rate': 'par077_severe_top_up_rate',\n                         'amended_per_decl_24m_rate': 'par045_amended_entry_rate',\n                         'top_up_per_final_tax_24m_rate': 'par048_top_up_share_final',\n                         'tax_reduced_per_decl_24m_rate': 'par066_negative_top_up_rate',\n                         'days_since_last_top_up': 'par105_days_since_last_top_up',\n                         'top_up_last_180d_flag': 'par105_top_up_180d',\n                         'main_station_per_decl_24m_rate': 'main_station_share',\n                         'away_from_main_station_per_decl_24m_rate': 'par023_station_spread',\n                         'priced_items_24m_count': 'items_benchmarked',\n                         'peer_price_shortfall_per_value_24m_rate': 'par076_shortfall_share',\n                         'topped_up_per_decl_3y_rate': 'top_up_entry_rate_3y',\n                         'severe_top_up_per_decl_3y_rate': 'par077_severe_top_up_rate_3y',\n                         'amended_per_decl_3y_rate': 'par045_amended_entry_rate_3y',\n                         'tax_reduced_per_decl_3y_rate': 'par066_negative_top_up_rate_3y',\n                         'top_up_per_final_tax_3y_rate': 'par048_top_up_share_final_3y',\n                         'unpaid_tax_per_decl_24m_rate': 'ctx_unpaid_rate',\n                         'pref_claimed_per_item_24m_rate': 'ctx_preferential_use_rate',\n                         'price_keying_error_per_item_24m_rate': 'ctx_implausible_price_rate',\n                         'price_under_half_peer_per_item_24m_rate': 'par076_low_price_item_rate',\n                         'median_price_dev_from_peer_24m_log': 'price_deviation_median',\n                         'priced_on_coo_peer_per_item_24m_rate': 'origin_benchmark_share',\n                         'own_price_drop_per_recent_value_6m_rate': 'own_price_drop_share',\n                         'hs_codes_compared_count': 'hs_codes_compared',\n                         'duty_under_half_peer_per_value_24m_rate': 'low_duty_value_share',\n                         'duty_gap_vs_peer_per_value_24m_rate': 'duty_gap_share',\n                         'exempt_apc_per_value_24m_rate': 'exemption_apc_value_share',\n                         'watchlist_apc_per_value_24m_rate': 'watchlist_apc_value_share',\n                         'same_day_split_per_decl_24m_rate': 'same_day_split_share',\n                         'same_day_norm_per_decl_24m_rate': 'same_day_split_expected',\n                         'same_day_split_per_decl_vs_norm_24m_diff': 'same_day_split_excess',\n                         'decl_90d_count': 'entries_last_90d',\n                         'decl_90d_per_avg_qtr_24m_log': 'surge',\n                         'hs4_24m_count': 'hs_headings_used',\n                         'hs4_per_decl_24m_ratio': 'goods_spread',\n                         'days_since_first_decl_24m': 'days_since_first_in_window',\n                         'new_importer_24m_score': 'newness'}\n    COMPARE = [c for c in PRODUCTION_COLUMN if c in feature_inputs.columns and PRODUCTION_COLUMN[c] in prod.columns]\n    mine = feature_inputs.select('taxpayer_tin', *[F.col(c).alias('a_' + c) for c in COMPARE])\n    theirs = prod.select(F.col('taxpayer_tin').cast('string').alias('taxpayer_tin'),\n                         *[F.col(PRODUCTION_COLUMN[c]).cast('double').alias('b_' + c) for c in COMPARE])\n    both = mine.join(theirs, 'taxpayer_tin')\n    def same(c):\n        a, b = F.col('a_' + c), F.col('b_' + c)\n        return (a.isNull() & b.isNull()) | (F.abs(a - b) <= 1e-5 + 1e-6 * F.abs(b))     # see the note above\n    share_same = [F.avg(F.coalesce(same(c), F.lit(False)).cast('double')).alias(c) for c in COMPARE]\n    result = both.select(F.count('*').alias('taxpayers in both'), *share_same).toPandas()\n    print('Taxpayers here: {:,}, in production: {:,}, in both: {:,}'.format(\n        feature_inputs.count(), prod.count(), int(result['taxpayers in both'][0])))\n    by_column = result.drop(columns='taxpayers in both').T.reset_index()\n    z.show(by_column.rename(columns={'index': 'column', 0: 'share matching'}))",
