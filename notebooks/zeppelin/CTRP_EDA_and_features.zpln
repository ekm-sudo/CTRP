        "forms": {}
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_ctrp_eda_046",
      "id": "paragraph_ctrp_eda_046",
      "dateCreated": "2026-10-20 00:00:00.000",
      "status": "READY"
    },
    {
      "title": "5.7 away_from_main_station_per_decl_24m_rate",
      "text": "%pyspark\nper_station = hist.groupBy('taxpayer_tin', 'station').count()          # a blank station counts as one station\nparts['away_from_main_station_per_decl_24m_rate'] = (per_station.groupBy('taxpayer_tin')\n                                             .agg((F.max('count') / F.sum('count')).alias('main_station_per_decl_24m_rate'))\n                                             .withColumn('away_from_main_station_per_decl_24m_rate', 1.0 - F.col('main_station_per_decl_24m_rate')))\npeek(parts['away_from_main_station_per_decl_24m_rate'])",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "python",
