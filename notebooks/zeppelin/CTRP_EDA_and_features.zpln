      "dateCreated": "2026-10-20 00:00:00.000",
      "status": "READY"
    },
    {
      "title": "5.6 top_up_last_180d_flag",
      "text": "%pyspark\nlast_top_up = F.max(F.when(F.col('topped_up') == 1, F.col('adate')))\ndays = hist.groupBy('taxpayer_tin').agg(F.datediff(snap_date, last_top_up).alias('days_since_last_top_up'))\nparts['top_up_last_180d_flag'] = days.withColumn(\n    'top_up_last_180d_flag', F.when(F.col('days_since_last_top_up') <= 180, 1.0).otherwise(0.0))\npeek(parts['top_up_last_180d_flag'])",
      "user": "anonymous",
