      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_ctrp_eda_052",
      "id": "paragraph_ctrp_eda_052",
      "dateCreated": "2026-10-20 00:00:00.000",
      "status": "READY"
    },
    {
      "title": "6.1 unpaid_tax_per_decl_24m_rate",
      "text": "%pyspark\nunpaid = F.when((F.col('pay_status') == 'NOT_PAID') & (F.col('final_tax') > 0), 1.0).otherwise(0.0)\nparts['unpaid_tax_per_decl_24m_rate'] = hist.groupBy('taxpayer_tin').agg(F.avg(unpaid).alias('unpaid_tax_per_decl_24m_rate'))\npeek(parts['unpaid_tax_per_decl_24m_rate'])",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "python",
          "editOnDblClick": false,
          "completionSupport": true
        },
        "editorMode": "ace/mode/python",
        "colWidth": 12.0,
        "fontSize": 9.0,
        "title": true,
        "editorHide": false,
        "results": {},
        "enabled": true
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "apps": [],
