      "jobName": "paragraph_ctrp_eda_004",
      "id": "paragraph_ctrp_eda_004",
      "dateCreated": "2026-10-20 00:00:00.000",
      "status": "READY"
    },
    {
      "title": "1.2 Columns",
      "text": "%pyspark\n# Each column: its type, an example, and how often it is blank\nblank = rows.select([F.avg(F.col(c).isNull().cast('double')).alias(c) for c in rows.columns]).first().asDict()\nexample = rows.limit(1000).toPandas()\noverview = pd.DataFrame({\n    'column': rows.columns,\n    'type': [t for _, t in rows.dtypes],\n    'example': [example[c].dropna().iloc[0] if example[c].notna().any() else None for c in rows.columns],\n    'blank %': [round(100 * blank[c], 1) for c in rows.columns],\n})\noverview['example'] = overview['example'].astype(str)\nz.show(overview)",
      "user": "anonymous",
      "dateUpdated": "2026-10-20 00:00:00.000",
      "progress": 0,
      "config": {
